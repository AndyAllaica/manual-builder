{
  "name": "manual-builder-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extension Manual Builder para seleccionar elementos, capturar la pestana visible y revisar resultados con contexto.",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wxt": "0.20.27"
  }
}
